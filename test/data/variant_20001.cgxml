  <Points><POINTID>3</POINTID><IMMOVABLEID>7</IMMOVABLEID><NO>3</NO><X>502010</X><Y>402000</Y></Points>
  <Points><POINTID>4</POINTID><IMMOVABLEID>7</IMMOVABLEID><NO>4</NO><X>502010</X><Y>402010</Y></Points>
  <Points><POINTID>5</POINTID><IMMOVABLEID>7</IMMOVABLEID><NO>5</NO><X>502000</X><Y>402010</Y></Points>
